rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Zero-Trust: Deny all direct client-side read and write access.
    // Cloud Storage operations are gated strictly via short-lived V4 Signed URLs generated by Firebase Admin SDK.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
